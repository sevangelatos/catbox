#!/usr/bin/env bash
set -euo pipefail

# --- Help ---
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'EOF'
Usage: catbox [WORKSPACE] [--gpu] [-- COMMAND...]

Launch a bubblewrap sandbox for a coding agent.

Arguments:
  WORKSPACE        Existing directory to use as workspace, or name of a
                   new workspace under ~/.sandboxes/ (default: default)
  --gpu            Passthrough GPU devices (NVIDIA / DRM) into sandbox
  --               Optional separator before command args
  COMMAND          Command to run inside the sandbox

Examples:
  catbox                              # Use ~/.sandboxes/default
  catbox myproject                    # Use ~/.sandboxes/myproject
  catbox /path/to/existing/dir        # Use /path/to/existing/dir
  catbox -- python script.py          # Run a command
  catbox dev -- python script.py      # Run a command in dev workspace
  catbox --gpu -- nvidia-smi          # Run with GPU passthrough
EOF
    exit 0
fi

# --- Configuration ---
WORKSPACE_INPUT="default"
GPU_ENABLED=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --gpu) GPU_ENABLED=true; shift ;;
        --)    shift; break ;;
        -*)    echo "Unknown option: $1" >&2; exit 1 ;;
        *)     WORKSPACE_INPUT="$1"; shift ;;
    esac
done

# If input is an existing directory, use it directly.
# Otherwise, treat it as a workspace name under ~/.sandboxes/
if [[ -d "$WORKSPACE_INPUT" ]]; then
    HOST_WORKSPACE_PATH="$(realpath "$WORKSPACE_INPUT")"
else
    if ! [[ "$WORKSPACE_INPUT" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        echo "Error: Workspace name must be alphanumeric (dashes and underscores allowed)."
        exit 1
    fi
    BASE_WORKSPACE_DIR="${HOME}/.sandboxes"
    HOST_WORKSPACE_PATH="$BASE_WORKSPACE_DIR/$WORKSPACE_INPUT"
fi

REAL_USER="$USER"
REAL_HOME="$HOME"
REAL_UID=$(id -u)
REAL_GID=$(id -g)

# --- Detect pi-node directory (for node, npm, pi binaries) ---
PI_NODE_BIN=
shopt -s nullglob
for dir in "$REAL_HOME"/.local/share/pi-node/node-*/bin; do
    [ -d "$dir" ] && PI_NODE_BIN="$dir" && break
done

# --- Prerequisites ---
if ! command -v bwrap &> /dev/null; then
    echo "Error: bubblewrap (bwrap) is not installed."
    echo "Install with: sudo apt install bubblewrap"
    exit 1
fi

# --- Create workspace directory if not already exists ---
mkdir -p "$HOST_WORKSPACE_PATH"

echo "🚀 Launching coding agent sandbox..."
echo "👤  User: $REAL_USER (UID=$REAL_UID, GID=$REAL_GID)"
echo "📂  Workspace: $HOST_WORKSPACE_PATH"
echo "🔒  System: RO  |  Home: whitelist-only  |  Namespaces: user+pid+ipc"
[[ "$GPU_ENABLED" == "true" ]] && echo "🎮  GPU: passthrough enabled (NVIDIA + DRM)"
echo "--------------------------------------------------"

# --- Build conditional arguments ---
SNAP_ARG=()
[[ -d /snap ]] && SNAP_ARG=(--ro-bind /snap /snap)

CGROUP_ARGS=()
[[ -d /sys/fs/cgroup ]] && CGROUP_ARGS=(--ro-bind /sys/fs/cgroup /sys/fs/cgroup)

# Fix DNS: /etc/resolv.conf is often a symlink to /run/systemd/resolve/...
# but /run is a tmpfs in the sandbox, breaking the symlink.
# Bind the systemd-resolve directory so the symlink resolves correctly.
DNS_ARGS=()
if [[ -d /run/systemd/resolve ]]; then
    DNS_ARGS=(--ro-bind /run/systemd/resolve /run/systemd/resolve)
fi

# Fix merged-/usr: On systems where /bin, /lib, /sbin are symlinks into /usr,
# --ro-bind follows the symlink and mounts the target as a real directory.
# This breaks relative symlinks inside /lib that expect /lib to be a symlink
# (e.g. /lib/gvfs/gvfsd -> ../../libexec/gvfsd resolves to /libexec/ not /usr/libexec/).
# Detect and recreate the symlink structure.
ROOT_ARGS=()
SYS_BINDS=()
if [[ -L /bin ]]; then
    # Merged-/usr: use tmpfs root + symlinks, skip redundant /bin,/lib binds
    ROOT_ARGS=(--tmpfs / --symlink usr/bin /bin --symlink usr/lib /lib --symlink usr/lib64 /lib64 --symlink usr/sbin /sbin)
else
    # Traditional: bind-mount real directories
    SYS_BINDS=(--ro-bind /bin /bin --ro-bind /lib /lib --ro-bind /lib64 /lib64 --ro-bind /sbin /sbin)
fi

# Fix missing data files that live outside /usr
DATA_BINDS=()
[[ -d /var/lib/ieee-data ]] && DATA_BINDS=(--ro-bind /var/lib/ieee-data /var/lib/ieee-data)

# GPU passthrough: bind NVIDIA + DRM devices and sysfs for PCI enumeration
GPU_ARGS=()
if [[ "${GPU_ENABLED:-}" == "true" ]]; then
    for dev in /dev/nvidiactl /dev/nvidia-uvm /dev/nvidia-uvm-tools /dev/nvidia-modeset /dev/dri /dev/dxg; do
        [[ -e "$dev" ]] && GPU_ARGS+=(--dev-bind-try "$dev" "$dev")
    done
    for i in {0..15}; do
        [[ -e "/dev/nvidia$i" ]] && GPU_ARGS+=(--dev-bind-try "/dev/nvidia$i" "/dev/nvidia$i")
    done
    GPU_ARGS+=(--ro-bind /sys /sys)
fi

# Build optional bind args (check existence before binding)
BIND_ARGS=()
[[ -f "$REAL_HOME/.bashrc" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.bashrc" "$REAL_HOME/.bashrc")
[[ -f "$REAL_HOME/.gitconfig" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.gitconfig" "$REAL_HOME/.gitconfig")
[[ -f "$REAL_HOME/.profile" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.profile" "$REAL_HOME/.profile")
[[ -d "$REAL_HOME/.pi" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.pi" "$REAL_HOME/.pi")
[[ -d "$REAL_HOME/.local" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.local" "$REAL_HOME/.local")
[[ -d "$REAL_HOME/.npm" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.npm" "$REAL_HOME/.npm")
[[ -d "$REAL_HOME/.opencode" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.opencode" "$REAL_HOME/.opencode")
[[ -d "$REAL_HOME/.config/opencode" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.config/opencode" "$REAL_HOME/.config/opencode")
[[ -d "$REAL_HOME/.cache/opencode" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.cache/opencode" "$REAL_HOME/.cache/opencode")

# Build the bwrap command as an array
BWRAP_ARGS=(
    --unshare-user
    --uid "$REAL_UID"
    --gid "$REAL_GID"
    --cap-drop ALL
    --unshare-pid
    --unshare-ipc

    "${ROOT_ARGS[@]}"

    --ro-bind /usr /usr
    "${SYS_BINDS[@]}"
    --ro-bind /etc /etc
    --ro-bind /opt /opt
    "${SNAP_ARG[@]}"
    "${CGROUP_ARGS[@]}"

    --tmpfs /tmp
    --tmpfs /var/tmp
    --tmpfs /run
    "${DNS_ARGS[@]}"
    "${DATA_BINDS[@]}"
    --proc /proc
    --dev /dev
    "${GPU_ARGS[@]}"

    --tmpfs "$REAL_HOME"
    "${BIND_ARGS[@]}"
    --bind "$HOST_WORKSPACE_PATH" "$REAL_HOME/workspace"

    --share-net
    --setenv HOME "$REAL_HOME"
    --setenv USER "$REAL_USER"
    --setenv LOGNAME "$REAL_USER"
    --setenv PATH "$REAL_HOME/.local/bin${PI_NODE_BIN:+:$PI_NODE_BIN}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    --chdir "$REAL_HOME/workspace"
)

if [[ $# -eq 0 ]]; then
    exec bwrap "${BWRAP_ARGS[@]}" /bin/bash
else
    exec bwrap "${BWRAP_ARGS[@]}" "$@"
fi
