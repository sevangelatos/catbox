#!/usr/bin/env bash
set -euo pipefail

# --- Help ---
usage() {
    cat <<'EOF'
Usage: catbox [WORKSPACE] [--gpu] [--ro PATH]... [--rw PATH]...
              [--no-net] [--forward PORT]... [--dry-run] [-- COMMAND...]

Launch a bubblewrap sandbox for a coding agent.

Arguments:
  WORKSPACE        Existing directory to use as workspace, or name of a
                   new workspace under ~/.sandboxes/ (default: default)
  --gpu            Passthrough GPU devices (NVIDIA / DRM) into sandbox
  --ro PATH        Mount PATH read-only at the same path (repeatable)
  --rw PATH        Mount PATH read-write at the same path (repeatable)
  --no-net         Isolate the network: the sandbox only has its own
                   (empty) loopback interface
  --forward SPEC   Forward a host localhost port into the sandbox's
                   loopback. SPEC is PORT or HOST_PORT:SANDBOX_PORT
                   (repeatable, implies --no-net, needs socat;
                   SANDBOX_PORT must be >= 1024)
  --dry-run        Print the bwrap command instead of running it
  -h, --help       Show this help
  --               Optional separator before command args
  COMMAND          Command to run inside the sandbox

Examples:
  catbox                              # Use ~/.sandboxes/default
  catbox myproject                    # Use ~/.sandboxes/myproject
  catbox /path/to/existing/dir        # Use /path/to/existing/dir
  catbox -- python script.py          # Run a command
  catbox dev -- python script.py      # Run a command in dev workspace
  catbox --gpu -- nvidia-smi          # Run with GPU passthrough
  catbox --ro ~/datasets --rw /srv/out  # Extra read-only / read-write paths
  catbox --forward 11434 -- pi        # Only reach host localhost:11434
EOF
}

# --- Configuration ---
WORKSPACE_INPUT="default"
GPU_ENABLED=false
DRY_RUN=false
NO_NET=false
FORWARDS=()       # entries of the form "HOST_PORT:SANDBOX_PORT"
EXTRA_MOUNTS=()   # entries of the form "ro:/abs/path" or "rw:/abs/path"

die() { echo "Error: $*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --gpu) GPU_ENABLED=true; shift ;;
        --dry-run) DRY_RUN=true; shift ;;
        --ro|--rw)
            [[ $# -ge 2 && "$2" != -- ]] || die "$1 requires a PATH argument"
            EXTRA_MOUNTS+=("${1#--}:$2"); shift 2 ;;
        --no-net) NO_NET=true; shift ;;
        --forward)
            [[ $# -ge 2 && "$2" != -- ]] || die "--forward requires a PORT argument"
            spec="$2"
            [[ "$spec" =~ ^[0-9]+(:[0-9]+)?$ ]] || die "invalid --forward spec: $spec"
            [[ "$spec" == *:* ]] || spec="$spec:$spec"
            for port in "${spec%%:*}" "${spec##*:}"; do
                (( 10#$port >= 1 && 10#$port <= 65535 )) || die "port out of range in --forward: $2"
            done
            spec="$((10#${spec%%:*})):$((10#${spec##*:}))"
            (( ${spec##*:} >= 1024 )) || die "sandbox port must be >= 1024 (no capabilities to bind lower ports): $2"
            for f in "${FORWARDS[@]}"; do
                [[ "${f##*:}" != "${spec##*:}" ]] || die "sandbox port ${spec##*:} is forwarded twice"
            done
            FORWARDS+=("$spec"); NO_NET=true; shift 2 ;;
        --)    shift; break ;;
        -*)    echo "Unknown option: $1" >&2; exit 1 ;;
        *)     WORKSPACE_INPUT="$1"; shift ;;
    esac
done

REAL_USER="$USER"
REAL_HOME="$HOME"
REAL_UID=$(id -u)
REAL_GID=$(id -g)

# If input is an existing directory, use it directly.
# Otherwise, treat it as a workspace name under ~/.sandboxes/
SANDBOX_WORKSPACE_PATH="$REAL_HOME/workspace"
if [[ -d "$WORKSPACE_INPUT" ]]; then
    HOST_WORKSPACE_PATH="$(realpath -s "$WORKSPACE_INPUT")"
    SANDBOX_WORKSPACE_PATH="$HOST_WORKSPACE_PATH"
else
    if ! [[ "$WORKSPACE_INPUT" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        echo "Error: Workspace name must be alphanumeric (dashes and underscores allowed)."
        exit 1
    fi
    BASE_WORKSPACE_DIR="${REAL_HOME}/.sandboxes"
    HOST_WORKSPACE_PATH="$BASE_WORKSPACE_DIR/$WORKSPACE_INPUT"
fi

# --- Validate extra mounts ---
# True if $1 is $2 or lies below it.
path_within() { [[ "$1" == "$2" || "$1" == "${2%/}/"* ]]; }

# Paths that are already mounted by catbox: extra mounts may not be, inside
# or above them (read-only system paths), or equal/above them (tmpfs paths).
RESERVED_TREE=(/usr /etc /opt /bin /lib /lib64 /sbin /snap /proc /dev /sys)
RESERVED_ROOT=(/tmp /var/tmp /run)

EXTRA_ARGS=()
EXTRA_PATHS=()
EXTRA_MODES=()
WORKSPACE_PATHS=("$(realpath -m "$HOST_WORKSPACE_PATH")" "$(realpath -m "$SANDBOX_WORKSPACE_PATH")")
for entry in "${EXTRA_MOUNTS[@]}"; do
    mode="${entry%%:*}"
    raw="${entry#*:}"
    [[ -e "$raw" ]] || die "--$mode path does not exist: $raw"
    path="$(realpath -e "$raw")"
    [[ "$path" == "/" ]] && die "--$mode cannot mount /"
    path_within "$REAL_HOME" "$path" && die "--$mode path contains \$HOME: $path"
    for r in "${RESERVED_TREE[@]}"; do
        if path_within "$path" "$r" || path_within "$r" "$path"; then
            die "--$mode path overlaps system path $r: $path"
        fi
    done
    for r in "${RESERVED_ROOT[@]}"; do
        if [[ "$path" == "$r" ]] || path_within "$r" "$path"; then
            die "--$mode path overlaps $r: $path"
        fi
    done
    for w in "${WORKSPACE_PATHS[@]}"; do
        if path_within "$path" "$w" || path_within "$w" "$path"; then
            die "--$mode path overlaps the workspace ($w): $path"
        fi
    done
    for other in "${EXTRA_PATHS[@]}"; do
        if path_within "$path" "$other" || path_within "$other" "$path"; then
            die "--$mode path overlaps another extra path ($other): $path"
        fi
    done
    EXTRA_PATHS+=("$path")
    EXTRA_MODES+=("$mode")
    if [[ "$mode" == "ro" ]]; then
        EXTRA_ARGS+=(--ro-bind "$path" "$path")
    else
        EXTRA_ARGS+=(--bind "$path" "$path")
    fi
done

# --- Detect pi-node directory (for node, npm, pi binaries) ---
PI_NODE_BIN=
shopt -s nullglob
for dir in "$REAL_HOME"/.local/share/pi-node/node-*/bin; do
    [ -d "$dir" ] && PI_NODE_BIN="$dir" && break
done

# --- Prerequisites ---
if ! command -v bwrap &> /dev/null; then
    echo "Error: bubblewrap (bwrap) is not installed."
    echo "Install with: sudo apt install bubblewrap"
    exit 1
fi

if [[ ${#FORWARDS[@]} -gt 0 ]] && ! command -v socat &> /dev/null; then
    die "--forward requires socat. Install with: sudo apt install socat"
fi

# --- Run directory: host-side sockets shared with the sandbox at /run/catbox ---
# Holds the forwarding sockets and the sandbox init script.
RUN_ARGS=()
RUNDIR=
CLEANUP_PIDS=()
cleanup() {
    [[ ${#CLEANUP_PIDS[@]} -gt 0 ]] && kill "${CLEANUP_PIDS[@]}" 2>/dev/null
    [[ -n "$RUNDIR" ]] && rm -rf "$RUNDIR"
    return 0
}
if [[ ${#FORWARDS[@]} -gt 0 ]]; then
    if [[ "$DRY_RUN" == "true" ]]; then
        RUNDIR="${XDG_RUNTIME_DIR:-/tmp}/catbox.XXXXXX"
    else
        RUNDIR="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/catbox.XXXXXX")"
    fi
    RUN_ARGS=(--ro-bind "$RUNDIR" /run/catbox)
fi

# --- Create workspace directory if not already exists ---
[[ "$DRY_RUN" == "true" ]] || mkdir -p "$HOST_WORKSPACE_PATH"

if [[ "$DRY_RUN" != "true" ]]; then
    echo "🚀 Launching coding agent sandbox..."
    echo "👤  User: $REAL_USER (UID=$REAL_UID, GID=$REAL_GID)"
    echo "📂  Workspace: $HOST_WORKSPACE_PATH → $SANDBOX_WORKSPACE_PATH"
    echo "🔒  System: RO  |  Home: whitelist-only  |  Namespaces: user+pid+ipc"
    [[ "$GPU_ENABLED" == "true" ]] && echo "🎮  GPU: passthrough enabled (NVIDIA + DRM)"
    if [[ "$NO_NET" == "true" ]]; then
        echo "🌐  Network: isolated (loopback only)"
    else
        echo "🌐  Network: shared with host"
    fi
    for f in "${FORWARDS[@]}"; do
        echo "🔌  Forward: host 127.0.0.1:${f%%:*} → sandbox 127.0.0.1:${f##*:}"
    done
    for i in "${!EXTRA_PATHS[@]}"; do
        echo "📎  Extra path (${EXTRA_MODES[$i]}): ${EXTRA_PATHS[$i]}"
    done
    echo "--------------------------------------------------"
fi

# --- Build conditional arguments ---
SNAP_ARG=()
[[ -d /snap ]] && SNAP_ARG=(--ro-bind /snap /snap)

CGROUP_ARGS=()
[[ -d /sys/fs/cgroup ]] && CGROUP_ARGS=(--ro-bind /sys/fs/cgroup /sys/fs/cgroup)

# Fix DNS: /etc/resolv.conf is often a symlink to /run/systemd/resolve/...
# but /run is a tmpfs in the sandbox, breaking the symlink.
# Bind the systemd-resolve directory so the symlink resolves correctly.
DNS_ARGS=()
if [[ -d /run/systemd/resolve ]]; then
    DNS_ARGS=(--ro-bind /run/systemd/resolve /run/systemd/resolve)
fi

# Fix merged-/usr: On systems where /bin, /lib, /sbin are symlinks into /usr,
# --ro-bind follows the symlink and mounts the target as a real directory.
# This breaks relative symlinks inside /lib that expect /lib to be a symlink
# (e.g. /lib/gvfs/gvfsd -> ../../libexec/gvfsd resolves to /libexec/ not /usr/libexec/).
# Detect and recreate the symlink structure.
ROOT_ARGS=()
SYS_BINDS=()
if [[ -L /bin ]]; then
    # Merged-/usr: use tmpfs root + symlinks, skip redundant /bin,/lib binds
    ROOT_ARGS=(--tmpfs / --symlink usr/bin /bin --symlink usr/lib /lib --symlink usr/lib64 /lib64 --symlink usr/sbin /sbin)
else
    # Traditional: bind-mount real directories
    SYS_BINDS=(--ro-bind /bin /bin --ro-bind /lib /lib --ro-bind /lib64 /lib64 --ro-bind /sbin /sbin)
fi

# Fix missing data files that live outside /usr
DATA_BINDS=()
[[ -d /var/lib/ieee-data ]] && DATA_BINDS=(--ro-bind /var/lib/ieee-data /var/lib/ieee-data)

# GPU passthrough: bind NVIDIA + DRM devices and sysfs for PCI enumeration
GPU_ARGS=()
if [[ "${GPU_ENABLED:-}" == "true" ]]; then
    for dev in /dev/nvidiactl /dev/nvidia-uvm /dev/nvidia-uvm-tools /dev/nvidia-modeset /dev/dri /dev/dxg; do
        [[ -e "$dev" ]] && GPU_ARGS+=(--dev-bind-try "$dev" "$dev")
    done
    for i in {0..15}; do
        [[ -e "/dev/nvidia$i" ]] && GPU_ARGS+=(--dev-bind-try "/dev/nvidia$i" "/dev/nvidia$i")
    done
    GPU_ARGS+=(--ro-bind /sys /sys)
fi

# Build optional bind args (check existence before binding)
BIND_ARGS=()
[[ -f "$REAL_HOME/.bashrc" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.bashrc" "$REAL_HOME/.bashrc")
[[ -f "$REAL_HOME/.gitconfig" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.gitconfig" "$REAL_HOME/.gitconfig")
[[ -f "$REAL_HOME/.profile" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.profile" "$REAL_HOME/.profile")
[[ -d "$REAL_HOME/.pi" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.pi" "$REAL_HOME/.pi")
[[ -d "$REAL_HOME/.local" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.local" "$REAL_HOME/.local")
[[ -d "$REAL_HOME/.npm" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.npm" "$REAL_HOME/.npm")
[[ -d "$REAL_HOME/.opencode" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.opencode" "$REAL_HOME/.opencode")
[[ -d "$REAL_HOME/.config/opencode" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.config/opencode" "$REAL_HOME/.config/opencode")
[[ -d "$REAL_HOME/.cache/opencode" ]] && BIND_ARGS+=(--bind "$REAL_HOME/.cache/opencode" "$REAL_HOME/.cache/opencode")

if [[ "$NO_NET" == "true" ]]; then
    NET_ARGS=(--unshare-net)
else
    NET_ARGS=(--share-net)
fi

# Build the bwrap command as an array
BWRAP_ARGS=(
    --unshare-user
    --uid "$REAL_UID"
    --gid "$REAL_GID"
    --cap-drop ALL
    --unshare-pid
    --unshare-ipc
    --die-with-parent

    "${ROOT_ARGS[@]}"

    --ro-bind /usr /usr
    "${SYS_BINDS[@]}"
    --ro-bind /etc /etc
    --ro-bind /opt /opt
    "${SNAP_ARG[@]}"
    "${CGROUP_ARGS[@]}"

    --tmpfs /tmp
    --tmpfs /var/tmp
    --tmpfs /run
    "${DNS_ARGS[@]}"
    "${RUN_ARGS[@]}"
    "${DATA_BINDS[@]}"
    --proc /proc
    --dev /dev
    "${GPU_ARGS[@]}"

    --tmpfs "$REAL_HOME"
    "${BIND_ARGS[@]}"
    --bind "$HOST_WORKSPACE_PATH" "$SANDBOX_WORKSPACE_PATH"
    "${EXTRA_ARGS[@]}"

    "${NET_ARGS[@]}"
    --setenv HOME "$REAL_HOME"
    --setenv USER "$REAL_USER"
    --setenv LOGNAME "$REAL_USER"
    --setenv PATH "$REAL_HOME/.local/bin${PI_NODE_BIN:+:$PI_NODE_BIN}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    --chdir "$SANDBOX_WORKSPACE_PATH"
)

CMD=("$@")
[[ ${#CMD[@]} -eq 0 ]] && CMD=(/bin/bash)

# With forwards, the command runs through an init script that starts the
# in-sandbox listeners (TCP on loopback -> unix socket in /run/catbox).
if [[ ${#FORWARDS[@]} -gt 0 ]]; then
    CMD=(/bin/bash /run/catbox/init.sh "${CMD[@]}")
fi

if [[ "$DRY_RUN" == "true" ]]; then
    printf '%q ' bwrap "${BWRAP_ARGS[@]}" "${CMD[@]}"
    echo
    exit 0
fi

if [[ ${#FORWARDS[@]} -eq 0 ]]; then
    exec bwrap "${BWRAP_ARGS[@]}" "${CMD[@]}"
fi

# Host side: one socat per forward, in its own session so a Ctrl-C on the
# terminal does not kill the forwarders while the sandbox shell lives on.
INIT="$RUNDIR/init.sh"
printf '#!/bin/bash\n' > "$INIT"
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
for f in "${FORWARDS[@]}"; do
    hport="${f%%:*}"; sport="${f##*:}"
    setsid socat "UNIX-LISTEN:$RUNDIR/fwd-$sport.sock,fork,mode=600" "TCP:127.0.0.1:$hport" &
    CLEANUP_PIDS+=($!)
    printf 'setsid socat TCP-LISTEN:%s,bind=127.0.0.1,reuseaddr,fork UNIX-CONNECT:/run/catbox/fwd-%s.sock &\n' \
        "$sport" "$sport" >> "$INIT"
done
printf 'exec "$@"\n' >> "$INIT"

# Remove the forwarders even if catbox is killed with SIGKILL.
setsid bash -c 'while kill -0 "$1" 2>/dev/null; do sleep 1; done
                shift; dir="$1"; shift; kill "$@" 2>/dev/null; rm -rf "$dir"' \
    _ $$ "$RUNDIR" "${CLEANUP_PIDS[@]}" &

# Wait for the sockets so the first connection from the sandbox cannot fail.
for f in "${FORWARDS[@]}"; do
    for _ in {1..50}; do [[ -S "$RUNDIR/fwd-${f##*:}.sock" ]] && break; sleep 0.1; done
done

bwrap "${BWRAP_ARGS[@]}" "${CMD[@]}"
exit $?
